{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name must match the Worker you connect in Workers Builds.
  "name": "stjb-thanks",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // Never expose the Worker on *.workers.dev or preview URLs: only the two custom domains.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Custom domains. Uncomment once the zone stjbscouncil.org is ready (see SETUP.md §D).
  "routes": [
    { "pattern": "thanks.stjbscouncil.org", "custom_domain": true },
    { "pattern": "thanks-admin.stjbscouncil.org", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stjb-thanks-prod",
      // Replace with the id printed by `npx wrangler d1 create stjb-thanks-prod`.
      "database_id": "9a5b3782-bc19-4651-9c1b-4d4f83e900c0",
      "migrations_dir": "migrations"
    }
  ],

  // Private R2 bucket for scheduled D1 backups (created with `wrangler r2 bucket create stjb-thanks-backups`).
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "stjb-thanks-backups" }],

  // Backups at 14:00, 14:30, 14:40, 14:50, 15:00, 15:30, 16:00 and 18:00 WIB (UTC+7). Cron runs in UTC.
  "triggers": {
    "crons": ["0 7,8,9,11 * * *", "30 7,8 * * *", "40 7 * * *", "50 7 * * *"]
  },

  "ratelimits": [
    // Per-browser (keyed by the HttpOnly browser id): 30 attempts / minute.
    { "name": "BROWSER_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    // Shared-network backstop. A whole school may share one public IP, so this is deliberately high.
    { "name": "NETWORK_LIMITER", "namespace_id": "4102", "simple": { "limit": 10000, "period": 60 } },
    // Global budget of *failed* class-code lookups (successes are never counted). Anti-guessing.
    { "name": "CODE_MISS_LIMITER", "namespace_id": "4103", "simple": { "limit": 300, "period": 60 } }
  ],

  // Non-secret configuration (production). Secrets: see SETUP.md §G.
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_HOST": "thanks.stjbscouncil.org",
    "ADMIN_HOST": "thanks-admin.stjbscouncil.org",
    "ACCESS_TEAM_DOMAIN": "https://stjbs-council.cloudflareaccess.com",
    "ACCESS_AUD": "0e9324a17b701b2b204b7b9c7b7199c53d23c7e4d12eecb4d58b2bcdc0dc6cf5",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGCjWiR3RP6Wt_5y"
    // OWNER_EMAIL is set as a secret (keeps a personal email out of the repo): see SETUP.md §E.
  },

  "env": {
    // `npx wrangler deploy --env staging` -> Worker "stjb-thanks-staging"
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stjb-thanks-staging",
          "database_id": "a298116f-7f49-45eb-8b06-48a3783f4b29",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "BROWSER_LIMITER", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } },
        { "name": "NETWORK_LIMITER", "namespace_id": "4202", "simple": { "limit": 10000, "period": 60 } },
        { "name": "CODE_MISS_LIMITER", "namespace_id": "4203", "simple": { "limit": 300, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_HOST": "thanks-staging.stjbscouncil.org",
        "ADMIN_HOST": "thanks-admin-staging.stjbscouncil.org",
        "ACCESS_TEAM_DOMAIN": "https://stjbs-council.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE-WITH-STAGING-ACCESS-AUD",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      }
    }
  }
}
