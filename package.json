{
  "name": "stjb-thanks",
  "version": "1.0.0",
  "description": "STJB Teacher's Day appreciation platform",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787 --local",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787 --local",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test --trace off",
    "test:load": "node scripts/load-test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-dev.mjs && wrangler d1 execute DB --local --file=.wrangler/seed-dev.sql",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/16JoeTheCoder/stjbsforms.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/16JoeTheCoder/stjbsforms/issues"
  },
  "homepage": "https://github.com/16JoeTheCoder/stjbsforms#readme",
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-emoji": "^5.3.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "downshift": "^9.5.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
